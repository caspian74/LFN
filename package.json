{
  "name": "linea-frontera",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bake.mjs",
    "dev": "node scripts/dev-server.mjs 8788",
    "test": "node scripts/test-api.mjs",
    "db:init": "wrangler d1 execute linea-frontera-db --remote --file=migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute linea-frontera-db --local --file=migrations/0001_init.sql",
    "deploy": "npm run build && wrangler pages deploy public --project-name linea-frontera"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
